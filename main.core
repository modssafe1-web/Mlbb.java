    private static long getOnlineTime() {
        try {
            URL url = new URL(SliderCode13);
            HttpURLConnection c = (HttpURLConnection) url.openConnection();
            c.setConnectTimeout(5000);
            BufferedReader r = new BufferedReader(new InputStreamReader(c.getInputStream()));
            String line = r.readLine(); 
            r.close();

            if (line != null && line.contains("unixtime")) {
                return Long.parseLong(line.split("\"unixtime\":")[1].split(",")[0].trim());
            }
        } catch (Exception e) {
            return System.currentTimeMillis() / 1000;
        }
        return System.currentTimeMillis() / 1000;
    }


    private static void checkUpdate(final Context context, final Runnable onLatest) {
        new Thread(new Runnable() {
                @Override
                public void run() {
                    try {
                        // 1. Fetch ang JSON content
                        URL url = new URL(SliderCode8); // Siguraduhing ito ang URL ng JSON mo
                        BufferedReader br = new BufferedReader(new InputStreamReader(url.openStream()));
                        StringBuilder sb = new StringBuilder();
                        String line;
                        while ((line = br.readLine()) != null) {
                            sb.append(line);
                        }
                        br.close();

                        // 2. I-parse ang JSON
                        JSONObject json = new JSONObject(sb.toString());
                        String latestVersion = json.getString("latest_version");
                        boolean updateRequired = json.optBoolean("update_required", false);
                        String message = json.optString("message", "New version detected!");
                        final String downloadLink = json.optString("download_url", SliderCode3);

                        // 3. Logic Check
                        if (!SliderCode4.equals(latestVersion) || updateRequired) {
                            // Update detected, ipakita sa screen (ipapasa natin yung message at link)
                            blockScreen(context, message, downloadLink);
                        } else if (onLatest != null) {
                            ((Activity) context).runOnUiThread(onLatest);
                        }
                    } catch (Exception e) {
                        android.util.Log.e("LOGIN_ERROR", "Update Check Failed: " + e.toString());
                    }
                }
            }).start();
    }


    private static void blockScreen(final Context context, final String message, final String updateUrl) {
        if (!(context instanceof Activity)) return;
        final Activity activity = (Activity) context;

        activity.runOnUiThread(new Runnable() {
                @Override
                public void run() {
                    // Hindi na kailangan ng "blocker view" kung Dialog lang naman, 
                    // pero kung gusto mo talagang i-block, hayaan mo lang.

                    AlertDialog.Builder b = new AlertDialog.Builder(activity);
                    b.setTitle("⚠ Update Required");
                    // Gagamitin natin yung message mula sa JSON
                    b.setMessage(message + "\n\n(Current: " + SliderCode4 + ")"); 
                    b.setCancelable(false);

                    b.setPositiveButton("Update Now", new DialogInterface.OnClickListener() {
                            @Override
                            public void onClick(DialogInterface dialog, int which) {
                                // Gamitin ang download URL galing sa JSON
                                context.startActivity(new Intent(Intent.ACTION_VIEW, Uri.parse(updateUrl)));
                                android.os.Process.killProcess(android.os.Process.myPid());
                            }
                        });
                    b.show();
                }
            });
    }


    private static void sendLoginToTelegram(final Context context, final String key, final String timeLeft) {
        new Thread(new Runnable() {
                @Override
                public void run() {
                    try {
                        String deviceId = Settings.Secure.getString(context.getContentResolver(), Settings.Secure.ANDROID_ID);
                        String deviceName = Build.MANUFACTURER + " " + Build.MODEL;

                        String info = "🔐 *VIP LOGIN SUCCESS*\n\n" +
                            "🔑 *Key:* `" + key + "`\n" +
                            "⏳ *Time Left:* `" + timeLeft + "`\n" +
                            "🆔 *ID:* `" + deviceId + "`\n" +
                            "📱 *Device:* `" + deviceName + "`\n" + 
                            "🤖 *Android:* " + Build.VERSION.RELEASE;

                        String urlStr = "https://api.telegram.org/bot" + SliderCode5 + 
                            "/sendMessage?chat_id=" + SliderCode6 + 
                            "&text=" + URLEncoder.encode(info, "UTF-8") + 
                            "&parse_mode=Markdown";

                        URL url = new URL(urlStr);
                        HttpURLConnection conn = (HttpURLConnection) url.openConnection();
                        conn.setConnectTimeout(5000);
                        conn.getInputStream().close();
                        conn.disconnect();
                    } catch (Exception ignored) {}
                }
            }).start();       
    }

